{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Z.Env",
  "version": "0.6.6",
  "identifier": "com.yearszhuang.zenv",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Z.Env",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 520,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
